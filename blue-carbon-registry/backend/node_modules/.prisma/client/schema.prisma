generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  NGO
  ADMIN
  BUYER
}

enum ProjectStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  CREDITS_ISSUED
}

enum ReviewStep {
  METADATA_CHECK
  AI_PHOTO_CHECK
  GEO_SATELLITE_CHECK
  FIELD_VISIT_MARK
  FINAL_APPROVAL
}

enum NotificationType {
  PROJECT_SUBMITTED
  PROJECT_APPROVED
  PROJECT_REJECTED
  CREDITS_ISSUED
  CREDITS_PURCHASED
  SYSTEM_UPDATE
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  phone            String?
  name             String
  role             UserRole
  organizationName String?
  locale           String    @default("en")
  passwordHash     String?
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  // Relations
  projects          Project[]
  reviews           Review[]
  creditRetirements CreditRetirement[]
  notifications     Notification[]
  auditLogs         AuditLog[]

  @@map("users")
}

model Project {
  id          String        @id @default(cuid())
  ngoId       String
  title       String
  description String?
  status      ProjectStatus @default(DRAFT)

  // Location data
  latitude  Float?
  longitude Float?
  geojson   Json? // For polygon boundaries
  area      Float? // in hectares
  location  String? // human-readable location

  // Plantation data
  species      String[]
  saplingCount Int?
  plantingDate DateTime?

  // Metadata
  estimatedCredits Int?
  issuedCredits    Int?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  submittedAt      DateTime?
  approvedAt       DateTime?

  // Relations
  ngo           User           @relation(fields: [ngoId], references: [id])
  evidence      Evidence[]
  aiReport      AIReport?
  satSnapshots  SatSnapshot[]
  reviews       Review[]
  creditBatches CreditBatch[]
  surveys       Survey[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@map("projects")
}

model Evidence {
  id        String @id @default(cuid())
  projectId String
  fileUrl   String
  fileName  String
  fileType  String
  fileSize  Int

  // EXIF and metadata
  exifData Json?
  hash     String?

  createdAt DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("evidence")
}

model AIReport {
  id           String   @id @default(cuid())
  projectId    String   @unique
  authenticity Float // 0-1 score
  mangroveProb Float // 0-1 probability
  contextFit   Float // 0-1 score
  confidence   Int // 0-100 percentage
  issues       String[] // Array of identified issues
  processedAt  DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("ai_reports")
}

model SatSnapshot {
  id          String   @id @default(cuid())
  projectId   String
  captureDate DateTime
  ndvi        Float?
  ndwi        Float?
  thumbUrl    String?
  verdict     String? // "Improving", "Stable", "Declining"
  createdAt   DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("sat_snapshots")
}

model Review {
  id            String     @id @default(cuid())
  projectId     String
  reviewerId    String
  currentStep   ReviewStep
  stepData      Json? // Step-specific data and notes
  isCompleted   Boolean    @default(false)
  finalDecision String? // "APPROVE" or "REJECT"
  reviewNotes   String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  completedAt   DateTime?

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  reviewer User    @relation(fields: [reviewerId], references: [id])

  @@map("reviews")
}

model CreditBatch {
  id        String   @id @default(cuid())
  projectId String
  tokenId   String   @unique // ERC-1155 token ID
  amount    Int // Number of credits
  mintedTx  String? // Blockchain transaction hash
  mintedAt  DateTime @default(now())

  // Relations
  project     Project            @relation(fields: [projectId], references: [id])
  retirements CreditRetirement[]

  @@map("credit_batches")
}

model CreditRetirement {
  id        String   @id @default(cuid())
  buyerId   String
  tokenId   String
  amount    Int // Number of credits retired
  retiredTx String? // Blockchain transaction hash
  certUrl   String? // PDF certificate URL
  retiredAt DateTime @default(now())

  // Relations
  buyer       User        @relation(fields: [buyerId], references: [id])
  creditBatch CreditBatch @relation(fields: [tokenId], references: [tokenId])

  @@map("credit_retirements")
}

model Survey {
  id          String   @id @default(cuid())
  projectId   String
  surveyDate  DateTime
  survivalPct Float? // Survival percentage
  growthStage String? // Growth stage description
  notes       String?
  evidenceIds String[] // Array of evidence IDs
  createdAt   DateTime @default(now())

  // Relations
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("surveys")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  projectId String?
  type      NotificationType
  title     String
  message   String
  data      Json? // Additional notification data
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  projectId String?
  action    String // Action performed
  before    Json? // State before change
  after     Json? // State after change
  metadata  Json? // Additional metadata
  timestamp DateTime @default(now())

  // Relations
  actor   User     @relation(fields: [actorId], references: [id])
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("audit_logs")
}
